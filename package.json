{
  "name": "starter-ts",
  "version": "0.0.0",
  "description": "📦️ Zero-config TypeScript template for rapid development. Pre-configured with modern tooling to start coding",
  "keywords": [
    "clean-code",
    "git",
    "github",
    "starter-ts",
    "typescript",
    "zero-config"
  ],
  "homepage": "https://github.com/TheElegantCoding/starter-ts#readme",
  "bugs": {
    "url": "https://github.com/TheElegantCoding/starter-ts/issues"
  },
  "author": "Luis Monsalve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheElegantCoding/starter-ts.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "setup": "bunx gitlys init",
    "dev": "tsup --watch",
    "build": "bun run type:check && bun run lint && bun run format && tsup",
    "type:check": "tsc --noEmit",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "security:audit": "bun audit",
    "release": "bun run build && bunx gitlys release"
  },
  "devDependencies": {
    "@stacklys/oxlint-config": "^1.0.4",
    "@stacklys/tsconfig": "^1.0.2",
    "@types/node": "26.6.5",
    "gitlys": "^2.2.4",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.17.0"
  }
}